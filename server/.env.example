# Copy to .env for local development. In production set these as environment variables on your host.
PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string:
# mongodb+srv://USER:PASSWORD@cluster.mongodb.net/skillswap?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/skillswap
# At least 16 random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Optional: limit signups to certain email domains (comma separated). Empty = anyone can sign up.
ALLOWED_EMAIL_DOMAIN=
# Optional: only needed if the frontend is hosted on a different domain than this server.
# CORS_ORIGIN=https://your-frontend.example.com
# Emails that become administrators (comma separated). Set this to your own email to get your first admin.
ADMIN_EMAILS=
